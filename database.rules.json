{
  "rules": {
    ".read": false,
    ".write": false,

    "donors": {
      ".read": true,
      ".indexOn": ["status", "bloodGroup", "area", "ownerUid", "phone"],
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('ownerUid').val() === auth.uid || newData.child('ownerUid').val() === auth.uid)"
      }
    },

    "requests": {
      ".read": true,
      ".indexOn": ["status", "bloodGroup", "createdAt", "ownerUid"],
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },

    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "email", "uid", "phone"],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('uid').val() === auth.uid)",
        ".write": "!data.exists() || (auth != null && (root.child('admins').child(auth.uid).exists() || data.child('uid').val() === auth.uid))"
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["email", "username", "phone", "role"],
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        "role": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).exists()"
        }
      }
    },

    "admins": {
      ".indexOn": ["email", "role"],
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'super'"
      }
    },

    "queue": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["kind", "at", "ownerUid"],
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).exists())"
      }
    },

    "accounts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["email", "uid", "role"]
    },

    "notices": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "from", "to"]
    },

    "gallery": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "order"]
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
