{
  "rules": {
    ".read": false,
    ".write": false,

    "donors": {
      ".read": true,
      ".indexOn": ["status", "bloodGroup", "area", "ownerUid", "phone"],
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'admin' || (!newData.exists() && (data.child('ownerUid').val() === auth.uid || data.child('uid').val() === auth.uid)))"
      }
    },

    "_meta": {
      ".read": true,
      "donorCounter": {
        "$year": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "requests": {
      ".read": true,
      ".indexOn": ["status", "bloodGroup", "createdAt", "ownerUid"],
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },

    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "email", "uid", "phone"],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('uid').val() === auth.uid)",
        ".write": "!data.exists() || (auth != null && (root.child('admins').child(auth.uid).exists() || data.child('uid').val() === auth.uid || (!newData.exists() && (data.child('email').val() === root.child('users').child(auth.uid).child('email').val() || data.child('phone').val() === root.child('users').child(auth.uid).child('phone').val()))))"
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["email", "username", "phone", "role"],
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        "role": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).child('role').val() === 'admin'"
        },
        "donorStatus": {
          ".validate": "newData.val() !== 'approved' || root.child('admins').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "admins": {
      ".indexOn": ["email", "role"],
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'admin' || (!newData.exists() && $uid === auth.uid))",
        "role": {
          ".validate": "newData.val() === 'admin' || newData.val() === 'moderator'"
        }
      }
    },

    "queue": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["kind", "at", "ownerUid"],
      "$id": {
        ".write": "!data.exists() || (auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && (data.child('ownerUid').val() === auth.uid || data.child('uid').val() === auth.uid || (data.child('memberId').exists() && root.child('members').child(data.child('memberId').val()).child('uid').val() === auth.uid)))))"
      }
    },

    "accounts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["email", "uid", "role"],
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && (data.child('uid').val() === auth.uid || data.child('email').val() === root.child('users').child(auth.uid).child('email').val())))"
      }
    },

    "notices": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "from", "to"]
    },

    "gallery": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["status", "order"]
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
