{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'admin'",
    ".write": false,
    "donors": {
      ".read": true,
      ".indexOn": [
        "status",
        "bloodGroup",
        "area",
        "ownerUid",
        "phone"
      ]
    },
    "_meta": {
      ".read": true
    },
    "requests": {
      ".read": true,
      ".indexOn": [
        "status",
        "bloodGroup",
        "createdAt",
        "ownerUid"
      ]
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "status",
        "email",
        "uid",
        "phone"
      ],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('uid').val() === auth.uid || data.child('ownerUid').val() === auth.uid)"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "email",
        "username",
        "phone",
        "role",
        "donorId"
      ],
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
        "data": {
          ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists())",
          "noticeReads": {
            ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      }
    },
    "identityIndex": {
      "email": {
        ".read": "auth != null"
      }
    },
    "admins": {
      ".indexOn": [
        "email",
        "role",
        "status"
      ],
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "queue": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "kind",
        "at",
        "ownerUid"
      ]
    },
    "donations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "donorId",
        "ownerUid",
        "date",
        "approvedAt"
      ]
    },
    "accounts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "email",
        "uid",
        "role",
        "donorId"
      ],
      "$id": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "notices": {
      ".read": true,
      ".indexOn": [
        "status",
        "target",
        "from",
        "to"
      ]
    },
    "gallery": {
      ".read": true,
      ".indexOn": [
        "status",
        "order"
      ]
    },
    "settings": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'admin' || root.child('admins').child(auth.uid).child('role').val() === 'moderator')",
      "app": {
        ".read": true
      }
    },
    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "at",
        "mod",
        "who"
      ]
    },
    "messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "read",
        "at"
      ]
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "ownerUid",
        "status",
        "createdAt"
      ],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('ownerUid').val() === auth.uid)"
      }
    },
    "loginIndex": {
      ".read": true
    }
  }
}
