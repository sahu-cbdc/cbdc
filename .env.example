# CBDC environment variables (Vite)
#
# এই ফাইলটি `.env` হিসেবে কপি করে ব্যবহার করুন (`.env` git-এ commit হয় না)।
#
# ─── ImgBB (ছবি হোস্টিং) ────────────────────────────────────────────────
# ছবি আপলোডের public client-side API key (Firebase Storage ব্যবহার হয় না)
VITE_IMGBB_API_KEY=

# ─── Firebase (ঐচ্ছিক override) ─────────────────────────────────────────
# ডাটাবেস: **Firebase Realtime Database** (Firestore ব্যবহার হয় না)।
# কোডে (src/lib/firebase.ts) চলতি প্রজেক্ট chokbazarbloodclub-69d5f-এর
# config ইতিমধ্যে যাচাই করা আছে — সাধারণত কিছুই দেওয়ার দরকার নেই।
#
# অন্য প্রজেক্ট (যেমন staging) ব্যবহার করতে চাইলে Vite env নিয়মে
# **সবগুলো required একসাথে** দিন। আংশিক সেট দিলে অ্যাপ ইচ্ছাকৃতভাবে চালু হয় না
# (ভুল/পুরোনো config যেন চুপচাপ ব্যবহার না হয়)।
# একটিও না দিলে কোডের ডিফল্ট config ব্যবহৃত হয়।
#
# --- required (একসাথে সবগুলো) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_DATABASE_URL=            # Realtime Database URL — বাধ্যতামূলক
#
# --- optional ---
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
#
# নোট: Firebase web config গোপনীয় নয় (public client identifier) — নিরাপত্তা
# Realtime Database Security Rules (database.rules.json) দিয়ে কার্যকর। কোনো service
# account key / Admin SDK credential এখানে কখনোই রাখবেন না।
