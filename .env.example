# ─────────────────────────────────────────────────────────────────────────────
# Environment template — copy to `.env` locally. NEVER commit `.env`.
# These are SERVER-ONLY secrets. They are read by the Vite dev server / the
# Cloudflare Worker (via `npx wrangler secret put <NAME>`), never bundled into
# the client, never present in `localStorage`, and never returned by an API.
# Public Firebase web config uses `VITE_FIREBASE_*` (see src/config/firebase.ts)
# and is intentionally exempt — the web API key is public by design.
#
#   • dev:   cp .env.example .env   and fill the values below
#   • prod:  npx wrangler secret put IMGBB_API_KEY
#            npx wrangler secret put FIREBASE_SERVICE_ACCOUNT
#            npx wrangler secret put FIREBASE_PROJECT_ID
# ─────────────────────────────────────────────────────────────────────────────

# Service-account JSON for the Firebase project, as a JSON string (the Worker
# parses it to mint short-lived OAuth2 access tokens for privileged RTDB/Auth
# operations). If unset, privileged admin endpoints return "not configured".
FIREBASE_SERVICE_ACCOUNT=

# Firebase project id (used by the server for API/scoped calls).
FIREBASE_PROJECT_ID=

# ImgBB API key (server-side only, via POST /api/images/upload).
IMGBB_API_KEY=
