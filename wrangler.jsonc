{
  // Worker entry (server/index.ts) hosts the secure /api/... handlers.
  // Deploy secrets (never commit): `npx wrangler secret put FIREBASE_SERVICE_ACCOUNT`
  // and `IMGBB_API_KEY` (see .env.example). Public values are the `vars` below.
  "name": "cbdc",
  "compatibility_date": "2026-08-16",
  "main": "server/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_API_KEY": "AIzaSyBxUlGig2NtQLf6tZMRwK6xxzjScNIqbrM",
    "FIREBASE_DATABASE_URL": "https://chokbazarbloodclub-69d5f-default-rtdb.firebaseio.com"
  }
}
