{
  // Worker entry (server/index.ts) hosts the secure /api/... gateways.
  // NO configuration lives here: public service config comes from the single
  // shared source src/config/firebase.ts, and secrets are server-side only —
  // `npx wrangler secret put FIREBASE_SERVICE_ACCOUNT` and `IMGBB_API_KEY`
  // (for local dev use process environment variables).
  "name": "cbdc",
  "compatibility_date": "2026-08-16",
  "main": "server/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
