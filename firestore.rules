rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Staff (admin / moderator) is recorded in the `admins/{uid}` document.
    function staffRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : '';
    }

    function isStaff() {
      return staffRole() == 'admin' || staffRole() == 'super'
        || staffRole() == 'moderator' || staffRole() == 'mod';
    }
    function isAdmin() {
      return staffRole() == 'admin' || staffRole() == 'super';
    }
    function isApproved() {
      return resource.data.status == 'approved';
    }
    function isPublished() {
      return resource.data.status == 'published';
    }

    // ── donors — approved profiles are public; staff manages them ─────────
    // Public reads are always constrained to `where("status","==","approved")`
    // (see src/lib/store.ts), so only approved records are readable publicly.
    match /donors/{id} {
      allow read: if isApproved() || isStaff();
      allow create, update, delete: if isStaff();
    }

    // ── requests — anyone may submit; approved are public ─────────────────
    match /requests/{id} {
      allow create: if true;
      allow read: if isApproved() || isStaff();
      allow update, delete: if isStaff();
    }

    // ── members — donor sign-up applications ──────────────────────────────
    match /members/{id} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ── users — one doc per Firebase Auth uid ─────────────────────────────
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow update: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow delete: if isAdmin();
    }

    // ── admins — staff directory (doc id = auth uid) ──────────────────────
    // Each doc: { email, role: "admin"|"super"|"moderator"|"mod",
    //             permissions: [...], name, username, designation }
    // Client code resolves a role by querying `where("email","==",email)`.
    // Managed via Firebase console or Admin SDK (no client writes).
    match /admins/{uid} {
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow write: if false;
    }

    // ── queue — moderation queue (staff only) ─────────────────────────────
    match /queue/{id} {
      allow read, write: if isStaff();
    }

    // ── accounts — panel / team accounts (staff only) ─────────────────────
    match /accounts/{id} {
      allow read, write: if isStaff();
    }

    // ── notices — published notices are public ────────────────────────────
    match /notices/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isStaff();
    }

    // ── gallery — published images are public (ImgBB URL + metadata) ──────
    match /gallery/{id} {
      allow read: if isPublished() || isStaff();
      allow write: if isStaff();
    }

    // ── settings — app settings (e.g. settings/imgbb = ImgBB API key) ─────
    // ImgBB key is a public client-side key, so anyone can read it; only
    // staff may change it from the Admin Settings screen.
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
